{{!
    @template local_resourcelibrary/catalogue_pages_management

    Template for managing catalogue pages

    Context variables required for this template:
    * pages - Array of catalogue page objects
    * addurl - URL to add a new page
    * haspages - Boolean indicating if there are any pages

    Example context (json):
    {
        "pages": [
            {
                "id": 1,
                "name": "Science Courses",
                "categories": "Mathematics, Physics",
                "customfields": "level, difficulty",
                "timemodified": "2025-01-02 14:30",
                "editurl": "/local/resourcelibrary/edit.php?id=1",
                "deleteurl": "/local/resourcelibrary/edit.php?id=1&action=delete"
            }
        ],
        "addurl": "/local/resourcelibrary/edit.php",
        "haspages": true
    }
}}

<div class="catalogue-pages-management">
    <div class="mb-3">
        <a href="{{addurl}}" class="btn btn-primary">
            {{#str}}addcataloguepage, local_resourcelibrary{{/str}}
        </a>
    </div>

    {{#haspages}}
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{{#str}}name{{/str}}</th>
                    <th>{{#str}}categories, local_resourcelibrary{{/str}}</th>
                    <th>{{#str}}customfields, local_resourcelibrary{{/str}}</th>
                    <th>{{#str}}lastmodification, local_resourcelibrary{{/str}}</th>
                    <th>{{#str}}actions{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#pages}}
                <tr>
                    <td><a href="{{viewurl}}">{{name}}</a></td>
                    <td>{{categories}}</td>
                    <td>{{customfields}}</td>
                    <td>{{timemodified}}</td>
                    <td>
                        <a href="{{viewurl}}" class="btn btn-sm btn-primary">
                            {{#str}}viewitem, local_resourcelibrary{{/str}}
                        </a>
                        <a href="{{editurl}}" class="btn btn-sm btn-secondary ml-1">
                            {{#str}}edit{{/str}}
                        </a>
                        <a href="{{deleteurl}}" class="btn btn-sm btn-danger ml-1"
                           onclick="return confirm('{{#str}}areyousure, core{{/str}}')">
                            {{#str}}delete{{/str}}
                        </a>
                    </td>
                </tr>
                {{/pages}}
            </tbody>
        </table>
    </div>
    {{/haspages}}

    {{^haspages}}
    <div class="alert alert-info">
        {{#str}}noentities, local_resourcelibrary{{/str}}
    </div>
    {{/haspages}}
</div>
