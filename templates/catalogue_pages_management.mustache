{{!
    @template local_resourcelibrary/catalogue_pages_management

    Template for managing catalogue pages

    Context variables required for this template:
    * pages - Array of catalogue page objects
    * addurl - URL to add a new page
    * haspages - Boolean indicating if there are any pages

    Example context (json):
    {
        "pages": [
            {
                "id": 1,
                "name": "Science Courses",
                "categories": "Mathematics, Physics",
                "customfields": "level, difficulty",
                "timemodified": "2025-01-02 14:30",
                "editurl": "/local/resourcelibrary/edit.php?id=1",
                "deleteurl": "/local/resourcelibrary/edit.php?id=1&action=delete"
            }
        ],
        "addurl": "/local/resourcelibrary/edit.php",
        "haspages": true
    }
}}

<div class="catalogue-pages-management">
    <div class="mb-3 d-flex justify-content-end">
        <a href="{{addurl}}" class="btn btn-sm">
            {{#str}}addcataloguepage, local_resourcelibrary{{/str}}
        </a>
    </div>

    {{#haspages}}
    <div class="table">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{{#str}}name{{/str}}</th>
                    <th>{{#str}}categories, local_resourcelibrary{{/str}}</th>
                    <th>{{#str}}customfields, local_resourcelibrary{{/str}}</th>
                    <th>{{#str}}lastmodification, local_resourcelibrary{{/str}}</th>
                    <th>{{#str}}actions{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#pages}}
                <tr>
                    <td><a href="{{viewurl}}">{{name}}</a></td>
                    <td>{{categories}}</td>
                    <td>{{customfields}}</td>
                    <td>{{timemodified}}</td>
                    <td>
                        <div class="dropdown icon-no-margin">
                            <button class="btn btn-icon"
                                    type="button"
                                    id="actions-dropdown-{{id}}"
                                    data-toggle="dropdown"
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                    aria-label="{{#str}}actions{{/str}} - {{name}}">
                                {{#pix}} i/menu, core {{/pix}}
                            </button>
                            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="actions-dropdown-{{id}}">
                                <a class="dropdown-item" href="{{viewurl}}">
                                    {{#pix}} i/preview, core {{/pix}} {{#str}}viewitem, local_resourcelibrary{{/str}}
                                </a>
                                <a class="dropdown-item" href="{{editurl}}">
                                    {{#pix}} i/edit, core {{/pix}} {{#str}}edit{{/str}}
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" href="{{deleteurl}}"
                                   onclick="return confirm('{{#str}}areyousure, core{{/str}}')">
                                    {{#pix}} i/delete, core {{/pix}} {{#str}}delete{{/str}}
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
                {{/pages}}
            </tbody>
        </table>
    </div>
    {{/haspages}}

    {{^haspages}}
    <div class="alert alert-info">
        {{#str}}noentities, local_resourcelibrary{{/str}}
    </div>
    {{/haspages}}
</div>
