{{!
    @template local_resourcelibrary/catalogue_page_resourcelibrary

    This template renders the catalogue page resource library with pre-filtered courses.

    Example context (json):
    {
        "cataloguepage": {
            "id": 1,
            "name": "Science Courses"
        },
        "courses": [
            {
                "id": 1,
                "fullname": "Introduction to Physics",
                "summary": "Basic physics course",
                "categoryname": "Science"
            }
        ],
        "view": "cards",
        "sortcolumn": "name",
        "sortorder": "asc",
        "paging": 10,
        "noentitiesimg": "https://moodle.org/theme/image.php/boost/core/1602669996/i/empty",
        "displaycategories": true,
        "filtersformcontent": "<form>...</form>"
    }
}}

<div id="local-resourcelibrary-catalogue-{{uniqid}}" class="local-resourcelibrary block-cards"
     data-entity-type="course"
     data-region="resourcelibrary"
     role="navigation"
     data-parent-id="0"
     data-category-id="0"
     data-page-id="{{pageid}}"
     data-catalogue-page="{{cataloguepage.id}}">

    <div class="w-100 d-flex justify-content-end">
    {{#pagesurl}}
        <a href="{{pagesurl}}" class="btn btn-secondary btn-sm m-2" role="button">
            {{#str}}addcataloguepage, local_resourcelibrary{{/str}}
        </a>
    {{/pagesurl}}
    </div>

    <div class="container-fluid">
        <div class="row no-gutters">
            <div class="col-12">
                <div id="resourcelibrary-filter-{{uniqid}}">
                {{{ filtersformcontent }}}
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid resourcelibrary-content mt-4">
        <div data-region="display-modifiers" class="d-flex align-items-right flex-wrap justify-content-end"
                aria-label="{{#str}} aria:controls, local_resourcelibrary {{/str}}">
            <div id="resourcelibrary-permalink"></div>

            {{> local_resourcelibrary/nav-sort-selector }}
            {{> local_resourcelibrary/nav-display-selector }}
        </div>

        <div class="container-fluid p-0">
            <div id="entities-view-{{uniqid}}"
                    data-region="resourcelibrary-view"
                    data-display="{{view}}"
                    data-sort-column="{{sortcolumn}}"
                    data-sort-order="{{sortorder}}"
                    data-prev-display="{{view}}"
                    data-paging="{{paging}}"
                    data-total-items="{{totalItems}}"
                    data-current-page="{{currentPage}}"
                    data-items-per-page="{{itemsPerPage}}"
                    data-noentitiesimg="{{noentitiesimg}}"
                    data-displaycategories="{{displaycategories}}">

                <div data-region="resourcelibrary-view-content">
                    {{#hascourses}}
                        {{#view_cards}}
                            {{> local_resourcelibrary/view-cards }}
                        {{/view_cards}}
                        {{#view_list}}
                            {{> local_resourcelibrary/view-list }}
                        {{/view_list}}
                    {{/hascourses}}

                    {{^hascourses}}
                        {{> local_resourcelibrary/no-entities }}
                    {{/hascourses}}
                </div>

                <div data-region="loading">
                </div>

                <div data-region="pagination" class="mt-3">
                    {{#pagination}}
                        {{> local_resourcelibrary/simple_pagination }}
                    {{/pagination}}
                </div>
            </div>
        </div>
    </div>
</div>

{{#js}}
require([
    'jquery',
    'local_resourcelibrary/resourcelibrary',
    'local_resourcelibrary/filtersform',
    'local_resourcelibrary/permalink'
    ], function($, Main, FiltersForm, Permalink) {
    Main.init('#local-resourcelibrary-catalogue-{{uniqid}}');
    FiltersForm.init('#resourcelibrary-filter-{{uniqid}}');
    Permalink.init();
});
{{/js}}
